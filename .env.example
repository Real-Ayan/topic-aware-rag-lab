# Required
OPENAI_API_KEY=sk-your-key-here

# GPT-5.6 family (2026): luna | terra | sol
LLM_MODEL=gpt-5.6-terra
# CONTEXT_MODEL=gpt-5.6-luna
# EVAL_MODEL=gpt-5.6-terra
EMBEDDING_MODEL=text-embedding-3-large
REASONING_EFFORT=low

# Clustering — general defaults. Change via .env, then:
#   uv run scripts/run_topic_clustering.py --run-id <id> --reuse-embeddings
CLUSTER_METHOD=hdbscan
N_TOPICS=10
UMAP_N_COMPONENTS=5
UMAP_N_NEIGHBORS=15
UMAP_MIN_DIST=0.0
HDBSCAN_MIN_CLUSTER_SIZE=3
# HDBSCAN_MIN_SAMPLES=
HDBSCAN_SELECTION_METHOD=eom
TOPIC_LABEL_SAMPLES=10

# Retrieval (A+D): MMR diversity + soft topic routing on tagged KBs
TOP_K=5
RETRIEVE_CANDIDATES=20
MMR_ENABLED=true
MMR_LAMBDA=0.7
TOPIC_ROUTE_ENABLED=true
